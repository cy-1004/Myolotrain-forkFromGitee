# =====================================================================
# Myolotrain 部署配置模板。使用：cp .env.example .env，然后按注释修改。
# .env 含密钥，已被 .gitignore 忽略，不要提交到版本库。
# 本地开发（run.py）与 Docker 部署（docker compose）共用同一份 .env。
# =====================================================================

# ---------- 必填 ----------
# JWT 签名密钥，至少 32 位。生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
# 修改后所有已登录用户需要重新登录。对外部署模式（EXTERNAL_MODE=true）下不填会拒绝启动
SECRET_KEY=

# 数据库密码。Docker 部署时会用它初始化 Postgres 容器；本地开发时填本机 Postgres 的密码
POSTGRES_PASSWORD=

# ---------- 端口 ----------
# 首选端口。被占用时自动顺延到下一个（8000 → 8001 → ……），实际端口会打印在启动输出里。
#   Docker：宿主机端口，由 scripts/start.* 选定并记录在 .app_port，下次优先复用
#   本地开发：run.py / start.py 的监听端口
APP_PORT=8000
SERVER_PORT=8000
# 最多顺延尝试多少个端口
APP_PORT_MAX_TRIES=20
# true = 不顺延，端口被占用直接报错（防火墙/网关已固定端口时使用）
APP_PORT_STRICT=false

# ---------- 账号与访问 ----------
# 首次初始化数据库时 admin 账号的密码。留空时：对外部署模式（Docker 默认）随机生成并在启动日志中打印一次；
# 本地开发沿用默认密码 admin@123
ADMIN_INITIAL_PASSWORD=
# 登录令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=480
# 对外访问地址（含实际端口），webhook 等需要绝对链接的地方使用，例如 http://10.0.0.5:8001
PUBLIC_BASE_URL=
# 允许跨域的来源，JSON 数组。控制台与 API 同源部署时保持为空
CORS_ORIGINS=[]

# ---------- 数据库（Docker 中 POSTGRES_SERVER/PORT 由 compose 固定，无需修改） ----------
POSTGRES_USER=postgres
POSTGRES_DB=yolov8_platform
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# ---------- 一键训练流水线：自动标注 ----------
# 视觉大模型提供方：openrouter（云端，需 OPENROUTER_API_KEY）/ openai_compatible（本地 llama.cpp、vLLM 等）/ mock（离线测试）
VLM_PROVIDER=openrouter
# 推荐 235b（真实文物视频上召回 0.72，约 $0.0004/帧）；30b 便宜一半但召回约 0.53
VLM_MODEL=qwen/qwen3-vl-235b-a22b-instruct
OPENROUTER_API_KEY=
# 本地 OpenAI 兼容服务（图片不能出网时使用）
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8887/v1
OPENAI_COMPATIBLE_API_KEY=
# 管理员总开关：false 时禁止把文物图片发送到云端
ALLOW_CLOUD_VLM=true
# 并发请求数、单次超时（秒）、单个任务的费用上限（美元，0 为不限，达到后任务暂停等待处理）
# 单次请求约 10~15 秒；遇到 429 会自动退避重试，账号限流严时调低
VLM_MAX_CONCURRENCY=8
VLM_TIMEOUT_SECONDS=60
VLM_BUDGET_PER_RUN_USD=0
# SAM 收框用的权重（镜像已预置 sam2.1_b.pt）
SAM_MODEL=sam2.1_b.pt

# ---------- 一键训练流水线：任务与回调 ----------
# 同时执行的任务数（训练阶段另有全局 GPU 锁，同一时刻只训练一个）
PIPELINE_MAX_PARALLEL_RUNS=2
PIPELINE_MAX_VIDEO_MB=4096
PIPELINE_MAX_VIDEO_SECONDS=1800
# 数据目录剩余空间低于该值（GB）时拒绝新任务
PIPELINE_MIN_FREE_DISK_GB=10
# 默认禁止 webhook 回调内网地址（防 SSRF）；回调内网系统时把主机名或 IP 加进来，例如 ["10.0.0.8"]
WEBHOOK_ALLOWED_HOSTS=[]

# ---------- 运行模式 ----------
# 对外部署模式：禁用服务器文件系统浏览、限制路径参数、隐藏异常详情。Docker 镜像默认 true
# EXTERNAL_MODE=true
# Docker 中是否启用 GPU：auto（检测到 nvidia-smi 就启用）/ true / false。仅 scripts/start.* 使用
USE_GPU=auto
